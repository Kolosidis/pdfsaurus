  "description": "Turn any Docusaurus site into a polished PDF: cover, numbered table of contents with page numbers, bookmarks, page numbers.",
  "type": "module",
  "bin": {
    "pdfsaurus": "bin/cli.js"
  },
  "exports": "./src/index.js",
